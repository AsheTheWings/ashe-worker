{
  "schema_version": "opentelemetry.producer/signal-catalog/v1",
  "resource_schema": "opentelemetry-resource/v1",
  "signal_schema": "ashe-worker-signals/v2",
  "service_namespace": "ashe",
  "service_names": ["ashe-worker"],
  "catalog": {
    "traces": ["ashe.worker.lifecycle", "ashe.worker.qualification.canary", "ashe.worker.records.scan"],
    "trace_name_patterns": [],
    "span_events": [],
    "metrics": ["ashe.worker.lifecycle.count", "ashe.worker.qualification.canary.count"],
    "logs": ["ashe.worker.lifecycle", "ashe.worker.operation", "ashe.worker.qualification.canary"],
    "correlation_attributes": ["ashe.worker.telemetry.correlation_id"]
  },
  "allowed_attributes": {
    "traces": ["ashe.worker.lifecycle.phase", "ashe.worker.outcome", "ashe.worker.records.removed_days", "ashe.worker.records.uploaded", "ashe.worker.telemetry.correlation_id", "error.type"],
    "metrics": ["ashe.worker.lifecycle.phase"],
    "logs": ["ashe.worker.lifecycle.phase", "ashe.worker.operation", "ashe.worker.outcome", "ashe.worker.telemetry.correlation_id", "error.type", "event.name"]
  },
  "metric_dimensions": {"ashe.worker.lifecycle.phase": ["start", "stop"]},
  "metric_contract": {
    "ashe.worker.lifecycle.count": {"instrument": "counter", "unit": "1"},
    "ashe.worker.qualification.canary.count": {"instrument": "counter", "unit": "1"}
  },
  "attribute_values": {
    "ashe.worker.lifecycle.phase": ["start", "stop"],
    "ashe.worker.operation": ["activity", "clipboard", "configuration", "input", "interface", "records", "runtime", "text_action"],
    "ashe.worker.outcome": ["error", "rejected", "success"]
  },
  "error_classes": ["conflict", "dependency", "operational", "rejected", "unauthorized"]
}
