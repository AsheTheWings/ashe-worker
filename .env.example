# Secrets (required for their respective features)
FAL_KEY=
TERA_API_KEY=

# Speech transcription
FAL_STT_MODEL=fal-ai/elevenlabs/speech-to-text/scribe-v2
# ISO-639-3 code (eng, deu, ...); empty auto-detects.
FAL_LANGUAGE=eng
# Optional comma-separated keyterms; billed at +30% when set.
FAL_KEYTERMS=
# Convert verbalized punctuation in dictation into symbols: period,
# comma, question mark, exclamation mark, colon, semicolon, double and
# single quotes, new line, new paragraph. Say "literal" before a command
# to keep the words (e.g. "literal comma"). Set to 0 to disable.
ASHE_SPOKEN_PUNCTUATION=1
ASHE_OUTPUT_SAMPLE_RATE=48000

# Tera Responses API
TERA_API_BASE=https://tera.asheservices.online/v1
# Each LLM-backed feature can select its model independently.
# TERA_MODEL is the shared fallback when a feature-specific model is unset.
TERA_GRAMMAR_MODEL=gemini-latest
TERA_QUESTION_MODEL=gemini-latest
TERA_JOURNAL_MODEL=gemini-latest
ASHE_LLM_TEMPERATURE=0.2
# Empty omits reasoning from requests; any non-empty value is passed through unchanged.
TERA_LLM_REASONING_EFFORT=

# Activity tracking
ASHE_ACTIVITY_ENABLED=true
# Empty uses an artifacts/ directory beside ashe-worker.exe.
ASHE_ARTIFACTS_DIR=
# Unified activity and learning evidence capture continues while input-idle, but never while
# locked or while the foreground activity is denylisted.
ASHE_CAPTURE_INTERVAL=10
ASHE_TELEMETRY_INTERVAL=2
ASHE_BLOCK_MINUTES=10
ASHE_MONITOR=1
# After visual deduplication, retain evidence at least this often. Values below
# ASHE_CAPTURE_INTERVAL are clamped to that capture interval.
ASHE_MAX_FRAME_GAP_S=30
# Minimum 2 so the first and last selected frames are preserved.
ASHE_MAX_FRAMES_PER_CALL=100
ASHE_MAX_PAYLOAD_MB=48
ASHE_IDLE_THRESHOLD_S=120
# A static block with less active input time than this is stored without an LLM description.
ASHE_MIN_ACTIVE_SECONDS=30
ASHE_DENYLIST=
ASHE_FRAME_RETENTION_MINUTES=30

# Block-description context
ASHE_CONTEXT_BLOCKS=6
ASHE_MAX_SUMMARY_CHARS=1500

# Deterministic human-readable daily report (no daily LLM request)
ASHE_DAILY_REPORT_ENABLED=true
ASHE_DAILY_REPORT_GRACE_MINUTES=15

# Encrypted archive lifecycle. The release binary contains only public recipient
# material plus a passphrase-protected private-key envelope.
ASHE_ARCHIVE_PLAINTEXT_DAYS=2
ASHE_ARCHIVE_SCAN_MINUTES=5
# Authenticated Worker API origin. Feature routes are derived internally.
ASHE_WORKER_BASE_URL=https://worker.asheservices.online
ASHE_ARCHIVE_UPLOAD_TOKEN=

# Authenticated clipboard image paste. Ctrl+Alt+V uploads a clipboard bitmap and silently
# pastes the server-owned absolute remote path into the field that had focus.
ASHE_PASTE_UPLOAD_TOKEN=

# Linux/WSL release packaging (not used by the Windows worker at runtime)
ASHE_RELEASE_DIR=
ASHE_ARCHIVE_RECIPIENT_FILE=
