# Generated by `cargo run --bin ashe-worker-env`; never loaded.
# Every input of Ashe Worker with its development default.
# %APPDATA% and %LOCALAPPDATA% stand for the user's application data folders.

# Overlay file of NAME=value configuration lines.
# configuration, an absolute path; set in: process environment; production default: %APPDATA%\ashe-worker\config.env
ASHE_WORKER_OVERLAY_FILE=%APPDATA%\ashe-worker\config.env

# Protected file of NAME='value' lines, readable by its owner alone.
# configuration, an absolute path; set in: process environment; production default: %APPDATA%\ashe-worker\protected.env
ASHE_WORKER_PROTECTED_FILE=%APPDATA%\ashe-worker\protected.env

# Profile whose defaults apply.
# configuration, one of development, production; set in: overlay file, process environment; production default: none, required
# required
ASHE_WORKER_PROFILE=

# Deployment environment that telemetry reports.
# configuration, one of development, production; set in: overlay file, process environment; production default: production
ASHE_WORKER_DEPLOYMENT_ENVIRONMENT=development

# Directory of activity records, pending blocks, and upload state.
# configuration, an absolute path; set in: overlay file, process environment; production default: %LOCALAPPDATA%\ashe-worker
ASHE_WORKER_DATA_DIR=%LOCALAPPDATA%\ashe-worker

# Base URL of an OpenAI Responses API; requests go to <base>/responses.
# configuration, an http(s) URL; set in: overlay file, process environment; production default: none, required
# required
ASHE_WORKER_LLM_BASE_URL=

# Bearer key of the Responses API.
# protected, non-empty text; set in: protected file; production default: none, required
# required
ASHE_WORKER_LLM_API_KEY=

# Model that corrects selected text.
# configuration, non-empty text; set in: overlay file, process environment; production default: none, required
# required
ASHE_WORKER_GRAMMAR_MODEL=

# Model that answers a question about selected text.
# configuration, non-empty text; set in: overlay file, process environment; production default: none, required
# required
ASHE_WORKER_QUESTION_MODEL=

# Model that describes activity blocks and keeps the rolling summary; it must accept images.
# configuration, non-empty text; set in: overlay file, process environment; production default: none, required
# required
ASHE_WORKER_JOURNAL_MODEL=

# Sampling temperature of grammar correction.
# configuration, a number from 0 to 2; set in: overlay file, process environment; production default: 0.2
ASHE_WORKER_LLM_TEMPERATURE=0.2

# Reasoning effort passed unchanged with every request; empty omits it.
# configuration, text; set in: overlay file, process environment; production default: empty
ASHE_WORKER_LLM_REASONING_EFFORT=

# Whether activity tracking starts with the worker.
# configuration, true or false; set in: overlay file, process environment; production default: true
ASHE_WORKER_ACTIVITY_ENABLED=true

# Display that activity tracking captures, counted from 1.
# configuration, an integer from 1 to 16; set in: overlay file, process environment; production default: 1
ASHE_WORKER_MONITOR=1

# Seconds between screen captures.
# configuration, an integer from 1 to 3600; set in: overlay file, process environment; production default: 10
ASHE_WORKER_CAPTURE_INTERVAL_SECONDS=10

# Seconds between foreground-window samples.
# configuration, a number from 0.5 to 60; set in: overlay file, process environment; production default: 2
ASHE_WORKER_SAMPLE_INTERVAL_SECONDS=2

# Length of one activity block in minutes.
# configuration, an integer from 1 to 240; set in: overlay file, process environment; production default: 10
ASHE_WORKER_BLOCK_MINUTES=10

# Visual difference below which a capture repeats the previous one.
# configuration, a number from 0 to 100; set in: overlay file, process environment; production default: 2
ASHE_WORKER_DEDUP_THRESHOLD=2

# Longest gap between retained captures; raised to the capture interval.
# configuration, an integer from 1 to 3600; set in: overlay file, process environment; production default: 30
ASHE_WORKER_MAX_FRAME_GAP_SECONDS=30

# Most captures sent with one block description.
# configuration, an integer from 2 to 1000; set in: overlay file, process environment; production default: 100
ASHE_WORKER_MAX_FRAMES_PER_CALL=100

# Largest image payload of one block description, in megabytes.
# configuration, a number from 1 to 512; set in: overlay file, process environment; production default: 48
ASHE_WORKER_MAX_PAYLOAD_MB=48

# Input idle time after which the user counts as idle.
# configuration, a number from 10 to 86400; set in: overlay file, process environment; production default: 120
ASHE_WORKER_IDLE_THRESHOLD_SECONDS=120

# Active input below which a static block is stored without a description.
# configuration, an integer from 0 to 86400; set in: overlay file, process environment; production default: 30
ASHE_WORKER_MIN_ACTIVE_SECONDS=30

# Executable or window-title fragments that are never captured.
# configuration, entries separated by ;; set in: overlay file, process environment; production default: empty
ASHE_WORKER_DENYLIST=

# Minutes captures are kept after their block is described.
# configuration, an integer from 1 to 10080; set in: overlay file, process environment; production default: 30
ASHE_WORKER_FRAME_RETENTION_MINUTES=30

# Earlier blocks given as context to a block description.
# configuration, an integer from 0 to 100; set in: overlay file, process environment; production default: 6
ASHE_WORKER_CONTEXT_BLOCKS=6

# Longest rolling summary, in characters.
# configuration, an integer from 1 to 100000; set in: overlay file, process environment; production default: 1500
ASHE_WORKER_MAX_SUMMARY_CHARS=1500

# Whether each finished day gets a daily report.
# configuration, true or false; set in: overlay file, process environment; production default: true
ASHE_WORKER_DAILY_REPORT_ENABLED=true

# Minutes after midnight before the previous day's report is written.
# configuration, an integer from 0 to 1440; set in: overlay file, process environment; production default: 15
ASHE_WORKER_DAILY_REPORT_GRACE_MINUTES=15

# Origin of the server that receives activity records.
# configuration, an http(s) origin; set in: overlay file, process environment; production default: none, required
# required
ASHE_WORKER_SERVER_URL=

# Bearer token of record uploads.
# protected, non-empty text; set in: protected file; production default: none, required
# required
ASHE_WORKER_SERVER_TOKEN=

# Minutes between scans for finished days to upload.
# configuration, an integer from 1 to 1440; set in: overlay file, process environment; production default: 5
ASHE_WORKER_UPLOAD_SCAN_MINUTES=5

# Days an uploaded day stays on this machine.
# configuration, an integer from 1 to 3650; set in: overlay file, process environment; production default: 7
ASHE_WORKER_LOCAL_RETENTION_DAYS=7

# Trace exporter.
# configuration, one of otlp, console, none; set in: overlay file, process environment; production default: otlp
OTEL_TRACES_EXPORTER=otlp

# Metric exporter.
# configuration, one of otlp, console, none; set in: overlay file, process environment; production default: otlp
OTEL_METRICS_EXPORTER=otlp

# Log exporter.
# configuration, one of otlp, console, none; set in: overlay file, process environment; production default: otlp
OTEL_LOGS_EXPORTER=otlp

# OTLP/HTTP endpoint; each signal goes to <endpoint>/v1/<signal>.
# configuration, an http(s) URL; set in: overlay file, process environment; production default: none, required
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# OTLP headers as comma-separated key=value pairs.
# protected, text; set in: protected file; production default: none, required
OTEL_EXPORTER_OTLP_HEADERS=
